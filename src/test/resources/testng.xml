<!--
From Maven:
mvn clean test -Pcheck-cpp-files -Dtest.data.root="/"

From Java:
Run all tests from the test.jar. 
First build the classpath:

CP=""
CP="${CP}datasketches-java-9.1.0-tests.jar:"
CP="${CP}datasketches-java-9.1.0.jar:"
CP="${CP}testng-7.12.0.jar:"
CP="${CP}jcommander-1.83.jar:"
CP="${CP}slf4j-api-2.0.16.jar"
CP="${CP}slf4j-simple-2.0.16.jar"
CP="${CP}jquery-3.7.1.jar"
CP="${CP}guice-5.1.0.jar" #optional
CP="${CP}snakeyaml-2.6.jar" #optional

java -Dtest.data.root="/" \
     -cp "$CP" \
     org.testng.TestNG testng.xml -testnames "AllDSJavaTests"

On Windows use back-tic "`" for line continuation and ";" for classpath separation.
-->

<suite name="DSJavaSuite">

    <!-- Default: Run everything  -->
    <test name="AllDSJavaTests">
        <packages>
            <package name="org.apache.datasketches.*" />
        </packages>
    </test>

    <!-- Profile: Generate Java Files -->
    <test name="GenerateJavaFiles">
        <groups>
            <run>
                <include name="generate-java-files" />
                <exclude name="check-cpp-files" />
                <exclude name="check-go-files" />
                <exclude name="check-cpp-historical-files" />
            </run>
        </groups>
        <packages>
            <package name="org.apache.datasketches.*" />
        </packages>
    </test>

    <!-- Profile: Check Java Generated Files -->
    <test name="CheckJavaFiles">
        <groups>
            <run>
                <include name="check-java-files" />
                <exclude name="check-cpp-historical-files" />
                <exclude name="generate-java-files" />
                <exclude name="check-cpp-files" />
                <exclude name="check-go-files" />
            </run>
        </groups>
        <packages>
            <package name="org.apache.datasketches.*" />
        </packages>
    </test>

    <!-- Profile: Check C++ Generated Files -->
    <test name="CheckCppFiles">
        <groups>
            <run>
                <include name="check-cpp-files" />
                <exclude name="generate-java-files" />
                <exclude name="check-go-files" />
                <exclude name="check-cpp-historical-files" />
            </run>
        </groups>
        <packages>
            <package name="org.apache.datasketches.*" />
        </packages>
    </test>

    <!-- Profile: Check Go Generated Files -->
    <test name="CheckGoFiles">
        <groups>
            <run>
                <include name="check-go-files" />
                <exclude name="generate-java-files" />
                <exclude name="check-cpp-files" />
                <exclude name="check-cpp-historical-files" />
            </run>
        </groups>
        <packages>
            <package name="org.apache.datasketches.*" />
        </packages>
    </test>

    <!-- Profile: Check C++ Historical Files -->
    <test name="CheckCppHistoricalFiles">
        <groups>
            <run>
                <include name="check-cpp-historical-files" />
                <exclude name="generate-java-files" />
                <exclude name="check-cpp-files" />
                <exclude name="check-go-files" />
            </run>
        </groups>
        <packages>
            <package name="org.apache.datasketches.*" />
        </packages>
    </test>

</suite>
